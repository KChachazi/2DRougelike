# This .gitignore is tailored for a Unity project.
# Reference: https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size and may contain sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider cache
.vs/
.idea/
.vscode/

# Claude Code local (personal) settings — not shared across machines
.claude/settings.local.json

# Codex local project preferences (not shared across machines)
.codex/config.toml
docs/

# Unity UI Toolkit generated XML schemas
/UIElementsSchema/

# Claude 的每周参考代码/示例，不是工程本体，不进版本库
/Reference/

# Gradle cache directory (Android builds)
.gradle/

# Autogenerated solution/project files (Unity regenerates these on open)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D crash report info
sysinfo.txt

# Builds and packages
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
